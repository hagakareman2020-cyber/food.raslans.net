# ===== Supabase =====
# من Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح الخدمة — سرّي جداً، للسيرفر فقط. لا يبدأ بـ NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Groq (توليد المنيو) =====
# من https://console.groq.com/keys  — سرّي، للسيرفر فقط
GROQ_API_KEY=your-groq-api-key

# رابط الموقع العام (يُستخدم في أكواد QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# بريد/بريدات الأدمن الرئيسي (يفصل بينها فاصلة) — لهم لوحة قبول المطاعم
SUPER_ADMIN_EMAILS=admin@example.com

# مفتاح Pexels لصور الأطباق التلقائية — مجاني من https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key
